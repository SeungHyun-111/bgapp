{
  "name": "broadcast-overlay-widget",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop overlay widget for broadcast schedules.",
  "main": "src/main.js",
  "scripts": {
    "training:sync": "node scripts/train-reviewed-nlu.js",
    "queries:reviewed": "node scripts/manage-queries.js reviewed",
    "queries:all": "node scripts/manage-queries.js all",
    "queries:trained": "node scripts/manage-queries.js trained",
    "queries:apply-review": "node scripts/mark-reviewed-conversations.js",
    "training:prepare": "node scripts/prepare-usagi-training.js",
    "posttraining:prepare": "node scripts/mark-reviewed-conversations.js",
    "training:test": "node --test scripts/test-usagi-training.js",
    "bi:catalog": "node scripts/build-bi-catalog.js",
    "planner:test": "node --test scripts/test-bi-planner.js",
    "planner:demo": "node scripts/demo-bi-planner.js",
    "nlu:understanding-check": "node scripts/evaluate-query-understanding.js",
    "nlu:understanding-activate": "node scripts/train-reviewed-nlu.js",
    "bi:import-captures": "node scripts/import-bi-captures.js",
    "bi:reference-test": "node --test scripts/test-bi-captures.js",
    "bi:reference-smoke": "node scripts/smoke-bi-captures.js",
    "nlu:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/rasa.ps1 setup",
    "nlu:train": "node scripts/train-reviewed-nlu.js",
    "nlu:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/rasa.ps1 start",
    "nlu:label": "node scripts/label-query.js",
    "nlu:test": "node --test scripts/test-dialogue.js",
    "nlu:smoke": "node scripts/smoke-nlu.js",
    "bi:talk-test": "node --test scripts/test-bi-query.js scripts/test-dialogue.js scripts/test-entity-scope.js",
    "bi:team-smoke": "node scripts/smoke-team-dialogue.js",
    "bi:talk-smoke": "node scripts/smoke-bi-dialogue.js",
    "start": "electron .",
    "bi:test": "node scripts/test-power-bi.js",
    "bi:inspect": "node scripts/inspect-power-bi.js",
    "bi:analyze": "node scripts/analyze-power-bi-visuals.js",
    "bi:search-test": "node scripts/test-power-bi-search.js",
    "bi:visual-test": "node scripts/test-power-bi-visuals.js",
    "bi:dashboard-test": "node scripts/test-power-bi-dashboard.js",
    "bi:codes": "node scripts/update-program-codes.js",
    "queries:list": "node scripts/manage-queries.js",
    "queries:converted": "node scripts/manage-queries.js converted",
    "commands:test": "node --test scripts/test-commands.js",
    "qwen:learning:status": "node scripts/qwen-learning-status.js",
    "qwen:learning:test": "node --test scripts/test-qwen-learning.js scripts/test-bi-planner.js scripts/test-planner-integration.js scripts/test-live-bi-executor.js",
    "qwen:mask-test": "python -B scripts/test_qwen_masking.py"
  },
  "devDependencies": {
    "electron": "^37.10.3"
  },
  "packageManager": "pnpm@10.34.7",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "protobufjs",
      "@firebase/util",
      "re2",
      "sharp"
    ]
  }
}
