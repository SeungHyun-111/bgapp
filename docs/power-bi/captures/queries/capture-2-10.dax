DEFINE
	VAR __DS0FilterTable = 
		TREATAS({"[알렌오](26FW)체크셔켓"}, 'BO'[편성코드])

	VAR __DS0Core = 
		SUMMARIZECOLUMNS(
			ROLLUPADDISSUBTOTAL('BO'[YEAR(DAX)], "IsGrandTotalRowTotal"),
			__DS0FilterTable,
			"v_전체_방송중_한계달성률___", 'BO'[(전체/방송중)한계달성률(%)],
			"v_연동_방송중_예상취급___", 'BO'[(연동/방송중)예상취급(%)]
		)

	VAR __DS0PrimaryWindowed = 
		TOPN(502, __DS0Core, [IsGrandTotalRowTotal], 0, [v_전체_방송중_한계달성률___], 0, 'BO'[YEAR(DAX)], 1)

EVALUATE
	__DS0PrimaryWindowed

ORDER BY
	[IsGrandTotalRowTotal] DESC, [v_전체_방송중_한계달성률___] DESC, 'BO'[YEAR(DAX)]
