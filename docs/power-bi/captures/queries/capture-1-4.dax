DEFINE
	VAR __DS0FilterTable = 
		TREATAS({2026}, 'BO'[YEAR(DAX)])

	VAR __DS0FilterTable2 = 
		TREATAS({9}, 'BO'[MONTH(DAX)])

	VAR __DS0Core = 
		SUMMARIZECOLUMNS(
			ROLLUPADDISSUBTOTAL('BO'[브랜드], "IsGrandTotalRowTotal"),
			__DS0FilterTable,
			__DS0FilterTable2,
			"v_전체_한계_분_", 'BO'[(전체)한계(분)],
			"v_전체_취급_분_", 'BO'[(전체)취급(분)],
			"v_전체_예상매출액_V___분_", 'BO'[(전체)예상매출액(V-)(분)],
			"v_전체_취급달성률___", 'BO'[(전체)취급달성률(%)],
			"v_전체_매출달성률___", 'BO'[(전체)매출달성률(%)],
			"v_전체_한계달성률___", 'BO'[(전체)한계달성률(%)],
			"v_전체_미리주문_취급_목표___", 'BO'[(전체/미리주문)취급/목표(%)],
			"Sumv_전체_예상취급액", CALCULATE(SUM('BO'[(전체)예상취급액])),
			"Sumv_전체_예상매출액_V__", CALCULATE(
				SUM('BO'[(전체)예상매출액(V-)])
			),
			"Sumv_전체_한계이익", CALCULATE(SUM('BO'[(전체)한계이익]))
		)

	VAR __DS0PrimaryWindowed = 
		TOPN(502, __DS0Core, [IsGrandTotalRowTotal], 0, 'BO'[브랜드], 1)

EVALUATE
	__DS0PrimaryWindowed

ORDER BY
	[IsGrandTotalRowTotal] DESC, 'BO'[브랜드]
