DEFINE
	VAR __DS0FilterTable = 
		TREATAS({2026}, 'BO'[YEAR(DAX)])

	VAR __DS0FilterTable2 = 
		TREATAS({9}, 'BO'[MONTH(DAX)])

	VAR __DS0Core = 
		SUMMARIZECOLUMNS(
			'BO'[조직명],
			__DS0FilterTable,
			__DS0FilterTable2,
			"v_전체_한계달성률___", 'BO'[(전체)한계달성률(%)],
			"v_전체_취급달성률___", 'BO'[(전체)취급달성률(%)],
			"v_전체_매출달성률___", 'BO'[(전체)매출달성률(%)]
		)

	VAR __DS0PrimaryWindowed = 
		TOPN(1001, __DS0Core, [v_전체_한계달성률___], 0, 'BO'[조직명], 1)

EVALUATE
	__DS0PrimaryWindowed

ORDER BY
	[v_전체_한계달성률___] DESC, 'BO'[조직명]
