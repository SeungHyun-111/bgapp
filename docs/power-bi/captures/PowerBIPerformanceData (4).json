n\tVAR __DS0PrimaryWindowed = \r\n\t\tTOPN(\r\n\t\t\t102,\r\n\t\t\tSUMMARIZE(__DS0Core, 'BO'[HOUR(DAX)], [IsGrandTotalRowTotal]),\r\n\t\t\t[IsGrandTotalRowTotal],\r\n\t\t\t0,\r\n\t\t\t'BO'[HOUR(DAX)],\r\n\t\t\t1\r\n\t\t)\r\n\r\n\tVAR __DS0SecondaryBase = \r\n\t\tSUMMARIZE(__DS0Core, 'BO'[WEEKDAY(DAX)], [IsGrandTotalColumnTotal])\r\n\r\n\tVAR __DS0Secondary = \r\n\t\tTOPN(102, __DS0SecondaryBase, [IsGrandTotalColumnTotal], 1, 'BO'[WEEKDAY(DAX)], 1)\r\n\r\n\tVAR __DS0BodyLimited = \r\n\t\tNATURALLEFTOUTERJOIN(\r\n\t\t\t__DS0PrimaryWindowed,\r\n\t\t\tSUBSTITUTEWITHINDEX(\r\n\t\t\t\t__DS0Core,\r\n\t\t\t\t\"ColumnIndex\",\r\n\t\t\t\t__DS0Secondary,\r\n\t\t\t\t[IsGrandTotalColumnTotal],\r\n\t\t\t\tASC,\r\n\t\t\t\t'BO'[WEEKDAY(DAX)],\r\n\t\t\t\tASC\r\n\t\t\t)\r\n\t\t)\r\n\r\n\tVAR __DS0CoreNoInstanceFiltersNoTotals = \r\n\t\tFILTER(\r\n\t\t\tKEEPFILTERS(__DS0Core),\r\n\t\t\tAND([IsGrandTotalRowTotal] = FALSE, [IsGrandTotalColumnTotal] = FALSE)\r\n\t\t)\r\n\r\nEVALUATE\r\n\tGROUPBY(\r\n\t\t__DS0CoreNoInstanceFiltersNoTotals,\r\n\t\t\"Maxv_연동_방송중_예상취급___\", MAXX(CURRENTGROUP(), [v_연동_방송중_예상취급___])\r\n\t)\r\n\r\nEVALUATE\r\n\t__DS0Secondary\r\n\r\nORDER BY\r\n\t[IsGrandTotalColumnTotal], 'BO'[WEEKDAY(DAX)]\r\n\r\nEVALUATE\r\n\t__DS0BodyLimited\r\n\r\nORDER BY\r\n\t[IsGrandTotalRowTotal] DESC, 'BO'[HOUR(DAX)], [ColumnIndex]","RowCount":209}},{"name":"Execute Query","component":"AS","start":"2026-10-22T10:12:20.083Z","end":"2026-10-22T10:12:20.097Z","id":"E5AA0ED7-51F8-4492-9283-100483C7B127","parentId":"a6de8da3-d702-44ba-965e-33878b6057c4"},{"name":"Serialize Rowset","component":"AS","start":"2026-10-22T10:12:20.097Z","end":"2026-10-22T10:12:20.097Z","id":"3B7E426A-4162-415B-9B4E-4E15FBDFCFDE","parentId":"E5AA0ED7-51F8-4492-9283-100483C7B127"},{"name":"Visual Container Lifecycle","start":"2026-10-22T10:12:19.548Z","end":"2026-10-22T10:12:19.897Z","id":"3fb91781fe32fa4ccec0-0d3a3fefe36f395af280","metrics":{"status":1,"visualTitle":"테이블","visualId":"3fb91781fe32fa4ccec0","visua