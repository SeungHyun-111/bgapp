DEFINE
	VAR __DS0FilterTable = 
		FILTER(
			KEEPFILTERS(
				SUMMARIZE(
					VALUES('BO'),
					'BO'[방송일시],
					'BO'[다원구분],
					'BO'[MD분류],
					'BO'[편성코드],
					'BO'[대표업체명],
					'BO'[대표상품명],
					'BO'[편성 Comment],
					'BO'[영상구분],
					'BO'[거래형태],
					'BO'[영상ID],
					'BO'[MD명],
					'BO'[기업구분],
					'BO'[프로그램명],
					'BO'[아이템명]
				)
			),
			AND(
				'BO'[편성코드] IN {"[홀베리]당근주스"},
				('BO'[방송일시], 'BO'[다원구분], 'BO'[MD분류], 'BO'[편성코드], 'BO'[대표업체명], 'BO'[대표상품명], 'BO'[편성 Comment], 'BO'[영상구분], 'BO'[거래형태], 'BO'[영상ID], 'BO'[MD명], 'BO'[기업구분], 'BO'[프로그램명], 'BO'[아이템명]) IN {((DATE(2024, 10, 26) + TIME(0, 33, 0)), "전체", "건강식품", "[홀베리]당근주스", "홀푸드코리아 주식회사", "[홀베리]1일 1당근 유기농 당근주스 8박스(80g*14포*8박스)", "", "기존", "위수탁", 25531, "윤혜성", "중소기업", "SK스토아 프로그램", "1000")}
			)
		)

	VAR __DS0Core = 
		SUMMARIZECOLUMNS(
			ROLLUPADDISSUBTOTAL('BO'[HOUR(DAX)], "IsGrandTotalRowTotal"),
			ROLLUPADDISSUBTOTAL('BO'[WEEKDAY(DAX)], "IsGrandTotalColumnTotal"),
			__DS0FilterTable,
			"v_연동_방송중_예상취급___", 'BO'[(연동/방송중)예상취급(%)]
		)

	VAR __DS0PrimaryWindowed = 
		TOPN(
			102,
			SUMMARIZE(__DS0Core, 'BO'[HOUR(DAX)], [IsGrandTotalRowTotal]),
			[IsGrandTotalRowTotal],
			0,
			'BO'[HOUR(DAX)],
			1
		)

	VAR __DS0SecondaryBase = 
		SUMMARIZE(__DS0Core, 'BO'[WEEKDAY(DAX)], [IsGrandTotalColumnTotal])

	VAR __DS0Secondary = 
		TOPN(102, __DS0SecondaryBase, [IsGrandTotalColumnTotal], 1, 'BO'[WEEKDAY(DAX)], 1)

	VAR __DS0BodyLimited = 
		NATURALLEFTOUTERJOIN(
			__DS0PrimaryWindowed,
			SUBSTITUTEWITHINDEX(
				__DS0Core,
				"ColumnIndex",
				__DS0Secondary,
				[IsGrandTotalColumnTotal],
				ASC,
				'BO'[WEEKDAY(DAX)],
				ASC
			)
		)

	VAR __DS0CoreNoInstanceFiltersNoTotals = 
		FILTER(
			KEEPFILTERS(__DS0Core),
			AND([IsGrandTotalRowTotal] = FALSE, [IsGrandTotalColumnTotal] = FALSE)
		)

EVALUATE
	GROUPBY(
		__DS0CoreNoInstanceFiltersNoTotals,
		"Maxv_연동_방송중_예상취급___", MAXX(CURRENTGROUP(), [v_연동_방송중_예상취급___])
	)

EVALUATE
	__DS0Secondary

ORDER BY
	[IsGrandTotalColumnTotal], 'BO'[WEEKDAY(DAX)]

EVALUATE
	__DS0BodyLimited

ORDER BY
	[IsGrandTotalRowTotal] DESC, 'BO'[HOUR(DAX)], [ColumnIndex]
