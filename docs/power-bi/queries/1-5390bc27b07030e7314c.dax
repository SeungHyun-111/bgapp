DEFINE VAR __DS0FilterTable = 
	FILTER(
		KEEPFILTERS(
			SUMMARIZE(
				VALUES('BO'),
				'BO'[방송일시],
				'BO'[다원구분],
				'BO'[MD분류],
				'BO'[편성코드],
				'BO'[대표업체명],
				'BO'[대표상품명],
				'BO'[편성 Comment],
				'BO'[영상구분],
				'BO'[거래형태],
				'BO'[영상ID],
				'BO'[MD명],
				'BO'[기업구분],
				'BO'[프로그램명],
				'BO'[아이템명]
			)
		),
		AND(
			'BO'[편성코드] IN {"[홀베리]당근주스"},
			('BO'[방송일시], 'BO'[다원구분], 'BO'[MD분류], 'BO'[편성코드], 'BO'[대표업체명], 'BO'[대표상품명], 'BO'[편성 Comment], 'BO'[영상구분], 'BO'[거래형태], 'BO'[영상ID], 'BO'[MD명], 'BO'[기업구분], 'BO'[프로그램명], 'BO'[아이템명]) IN {((DATE(2024, 10, 26) + TIME(0, 33, 0)), "전체", "건강식품", "[홀베리]당근주스", "홀푸드코리아 주식회사", "[홀베리]1일 1당근 유기농 당근주스 8박스(80g*14포*8박스)", "", "기존", "위수탁", 25531, "윤혜성", "중소기업", "SK스토아 프로그램", "1000")}
		)
	)

EVALUATE
	SUMMARIZECOLUMNS(
		__DS0FilterTable,
		"Sumv_전체_미리주문_예상취급액_V__", IGNORE(
			CALCULATE(
				SUM('BO'[(전체/미리주문)예상취급액(V-)])
			)
		)
	)
