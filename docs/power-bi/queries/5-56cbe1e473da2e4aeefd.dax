DEFINE VAR __DS0FilterTable = 
	FILTER(
		KEEPFILTERS(
			SUMMARIZE(
				VALUES('BO'),
				'BO'[방송일시],
				'BO'[다원구분],
				'BO'[MD분류],
				'BO'[편성코드],
				'BO'[대표업체명],
				'BO'[대표상품명],
				'BO'[편성 Comment],
				'BO'[영상구분],
				'BO'[거래형태],
				'BO'[영상ID],
				'BO'[MD명],
				'BO'[기업구분],
				'BO'[프로그램명],
				'BO'[아이템명]
			)
		),
		AND(
			'BO'[편성코드] IN {"[홀베리]당근주스"},
			('BO'[방송일시], 'BO'[다원구분], 'BO'[MD분류], 'BO'[편성코드], 'BO'[대표업체명], 'BO'[대표상품명], 'BO'[편성 Comment], 'BO'[영상구분], 'BO'[거래형태], 'BO'[영상ID], 'BO'[MD명], 'BO'[기업구분], 'BO'[프로그램명], 'BO'[아이템명]) IN {((DATE(2024, 10, 26) + TIME(0, 33, 0)), "전체", "건강식품", "[홀베리]당근주스", "홀푸드코리아 주식회사", "[홀베리]1일 1당근 유기농 당근주스 8박스(80g*14포*8박스)", "", "기존", "위수탁", 25531, "윤혜성", "중소기업", "SK스토아 프로그램", "1000")}
		)
	)

EVALUATE
	SUMMARIZECOLUMNS(
		__DS0FilterTable,
		"v_전체_방송중_한계이익에서_정액수수료_원_을_를__뺀_값을_를___전체_방송중_예상취급액_V__에서_정액수수료_원_을_를__뺀_값_으_로_나눈_값", IGNORE(
			'BO'[(전체/방송중)한계이익에서 정액수수료(원)을(를) 뺀 값을(를) (전체/방송중)예상취급액(V-)에서 정액수수료(원)을(를) 뺀 값(으)로 나눈 값]
		)
	)
