# Gemini API configuration. Put the actual key in .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional: enter the model's project RPD limit shown in Google AI Studio.
GEMINI_REQUESTS_PER_DAY=
# Legacy local engine settings retained as comments.
# USE_LLM_PLANNER=false
# Curated learning runs manually; background training/evaluation is opt-in.
# USAGI_AUTO_TRAIN=false
# Set to the absolute path of your locally approved GGUF model.
# LOCAL_LLM_MODEL_PATH=
# LOCAL_LLM_PORT=8080
# Optional installed runtime directory; never downloaded automatically.
# LOCAL_LLM_RUNTIME_DIR=
# LOCAL_LLM_THREADS=8
# LOCAL_LLM_THREADS_BATCH=12
# LOCAL_LLM_CONTEXT_SIZE=8192
# Optional: connect to a separately managed local server instead of launching it.
# LLAMA_SERVER_URL=http://127.0.0.1:8080

# Qwen learning is distinct from the Rasa environment. No auto-install/download.
# Keep disabled until the dedicated environment, converter and evaluation data
# have been prepared. Corrections are collected even while training is disabled.
# QWEN_AUTO_TRAIN=false
# QWEN_TRAINING_MODEL_PATH=
# QWEN_TRAINING_PYTHON=
# LLAMA_CPP_DIR=
# QWEN_TRAIN_METHOD=qlora
# QWEN_TRAIN_DEVICE=auto
# QWEN_MIN_CORRECTION_GROUPS=10
# QWEN_MIN_HOLDOUT_GROUPS=2
# QWEN_MIN_FREE_RAM_GB=6
# QWEN_MAX_LENGTH=4096
# QWEN_LORA_RANK=8
# QWEN_TRAIN_EPOCHS=2
# Change deliberately to retry a failed dataset after fixing its environment.
# QWEN_RETRY_TOKEN=
