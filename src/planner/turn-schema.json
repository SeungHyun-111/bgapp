{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "action"
  ],
  "properties": {
    "action": {
      "type": "string",
      "enum": [
        "new",
        "modify",
        "add",
        "remove",
        "confirm",
        "cancel",
        "clarify"
      ]
    },
    "question": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "options": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "patch"
        ],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "patch": {
            "type": "object"
          }
        }
      }
    },
    "patch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operation": {
          "type": "string",
          "enum": [
            "list",
            "aggregate"
          ]
        },
        "target": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "brand",
                "organization",
                "product"
              ]
            },
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            }
          }
        },
        "fields": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "string"
          }
        },
        "metrics": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string"
          }
        },
        "filters": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "field",
              "operator",
              "value"
            ],
            "properties": {
              "field": {
                "type": "string"
              },
              "operator": {
                "type": "string",
                "enum": [
                  "eq",
                  "ne",
                  "gte",
                  "lt",
                  "contains",
                  "prefix",
                  "hour"
                ]
              },
              "value": {
                "type": [
                  "string",
                  "number"
                ],
                "maxLength": 300
              }
            }
          }
        },
        "groupBy": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "field",
              "unit"
            ],
            "properties": {
              "field": {
                "type": "string"
              },
              "unit": {
                "type": "string",
                "enum": [
                  "value",
                  "year",
                  "month",
                  "day",
                  "hour"
                ]
              }
            }
          }
        },
        "sort": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "field",
              "direction"
            ],
            "properties": {
              "field": {
                "type": "string"
              },
              "direction": {
                "type": "string",
                "enum": [
                  "asc",
                  "desc"
                ]
              }
            }
          }
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "share": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "numerator",
            "denominator"
          ],
          "properties": {
            "numerator": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "metric",
                "filters"
              ],
              "properties": {
                "metric": {
                  "type": "string"
                },
                "filters": {
                  "type": "array",
                  "maxItems": 16,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "field",
                      "operator",
                      "value"
                    ],
                    "properties": {
                      "field": {
                        "type": "string"
                      },
                      "operator": {
                        "type": "string",
                        "enum": [
                          "eq",
                          "ne",
                          "gte",
                          "lt",
                          "contains",
                          "prefix",
                          "hour"
                        ]
                      },
                      "value": {
                        "type": [
                          "string",
                          "number"
                        ],
                        "maxLength": 300
                      }
                    }
                  }
                }
              }
            },
            "denominator": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "metric",
                "filters",
                "groupBy"
              ],
              "properties": {
                "metric": {
                  "type": "string"
                },
                "filters": {
                  "type": "array",
                  "maxItems": 16,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "field",
                      "operator",
                      "value"
                    ],
                    "properties": {
                      "field": {
                        "type": "string"
                      },
                      "operator": {
                        "type": "string",
                        "enum": [
                          "eq",
                          "ne",
                          "gte",
                          "lt",
                          "contains",
                          "prefix",
                          "hour"
                        ]
                      },
                      "value": {
                        "type": [
                          "string",
                          "number"
                        ],
                        "maxLength": 300
                      }
                    }
                  }
                },
                "groupBy": {
                  "type": "array",
                  "maxItems": 3,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "field",
                      "unit"
                    ],
                    "properties": {
                      "field": {
                        "type": "string"
                      },
                      "unit": {
                        "type": "string",
                        "enum": [
                          "value",
                          "year",
                          "month",
                          "day",
                          "hour"
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "remove": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "string",
        "enum": [
          "target",
          "fields",
          "metrics",
          "filters",
          "groupBy",
          "sort",
          "share"
        ]
      }
    },
    "removeFilters": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "string"
      }
    },
    "interpretation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "fields"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "request",
            "correction",
            "confirmation",
            "clarification_answer"
          ]
        },
        "refersToTurnId": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 80
        },
        "fields": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "quote",
              "source"
            ],
            "properties": {
              "path": {
                "type": "string",
                "maxLength": 500
              },
              "quote": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "source": {
                "type": "string",
                "enum": [
                  "explicit_user_correction",
                  "model_inference",
                  "user_confirmation"
                ]
              }
            }
          }
        }
      }
    }
  }
}
