{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Validated BI query plan (no executable code)",
  "type":"object","additionalProperties":false,"required":["operation","fields","metrics","filters","groupBy","sort","limit"],
  "properties":{
    "operation":{"type":"string","enum":["list","aggregate"]},
    "target":{"type":["object","null"],"additionalProperties":false,"required":["kind","value"],"properties":{"kind":{"type":"string","enum":["brand","organization","product"]},"value":{"type":"string","minLength":1,"maxLength":300}}},
    "fields":{"type":"array","maxItems":12,"items":{"type":"string"}},
    "metrics":{"type":"array","maxItems":8,"items":{"type":"string"}},
    "filters":{"type":"array","maxItems":16,"items":{"type":"object","additionalProperties":false,"required":["field","operator","value"],"properties":{"field":{"type":"string"},"operator":{"type":"string","enum":["eq","ne","gte","lt","contains","prefix","hour"]},"value":{"type":["string","number"],"maxLength":300}}}},
    "groupBy":{"type":"array","maxItems":3,"items":{"type":"object","additionalProperties":false,"required":["field","unit"],"properties":{"field":{"type":"string"},"unit":{"type":"string","enum":["value","year","month","day","hour"]}}}},
    "sort":{"type":"array","maxItems":3,"items":{"type":"object","additionalProperties":false,"required":["field","direction"],"properties":{"field":{"type":"string"},"direction":{"type":"string","enum":["asc","desc"]}}}},
    "limit":{"type":"integer","minimum":1,"maximum":100}
  }
}
