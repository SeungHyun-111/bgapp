TE(SUM('BO'[가중분]))\r\n\t\t)\r\n\r\n\tVAR __DS0PrimaryWindowed = \r\n\t\tTOPN(502, __DS0Core, [IsGrandTotalRowTotal], 0, 'BO'[조직명], 0, 'BO'[MD분류], 1, 'BO'[편성코드], 1)\r\n\r\nEVALUATE\r\n\t__DS0PrimaryWindowed\r\n\r\nORDER BY\r\n\t[IsGrandTotalRowTotal] DESC, 'BO'[조직명] DESC, 'BO'[MD분류], 'BO'[편성코드]","RowCount":419}},{"name":"Execute Query","component":"AS","start":"2026-10-22T10:12:24.660Z","end":"2026-10-22T10:12:24.680Z","id":"A8EBD147-F5A3-45E1-B189-A55D418B4C8D","parentId":"7de5ade3-6047-41d3-88fd-8b9288661a01"},{"name":"Serialize Rowset","component":"AS","start":"2026-10-22T10:12:24.677Z","end":"2026-10-22T10:12:24.680Z","id":"73BF2C44-A6BB-438C-ACA5-55C04E6BCCDA","parentId":"A8EBD147-F5A3-45E1-B189-A55D418B4C8D"},{"name":"Visual Container Lifecycle","start":"2026-10-22T10:12:24.155Z","end":"2026-10-22T10:12:24.385Z","id":"e72b854ebdad15209326-7a636bbe5542c707b6ec","metrics":{"status":1,"visualTitle":"행렬","visualId":"e72b854ebdad15209326","visualType":"pivotTable","initialLoad":false}},{"name":"Query","start":"2026-10-22T10:12:24.156Z","end":"2026-10-22T10:12:24.338Z","id":"545bdd6d-2454-4daf-87d8-483921fec93d","parentId":"e72b854ebdad15209326-7a636bbe5542c707b6ec"},{"name":"Render","start":"2026-10-22T10:12:24.337Z","end":"2026-10-22T10:12:24.385Z","id":"9008e6ab-c90d-4f5f-ab42-698752544b77","parentId":"e72b854ebdad15209326-7a636bbe5542c707b6ec"},{"name":"Data View Transform","start":"2026-10-22T10:12:24.342Z","end":"2026-10-22T10:12:24.344Z","id":"2ed9ddaa-7650-4366-b324-239348292412","parentId":"9008e6ab-c90d-4f5f-ab42-698752544b77"},{"name":"Visual Update Async","start":"2026-10-22T10:12:24.345Z","end":"2026-10-22T10:12:24.385Z","id":"45edaf20-11f9-4a17-81e9-da789681c60b","parentId":"9008e6ab-c90d-4f5f-ab42-698752544b77"},{"name":"Visual Update","start":"2026-10-22T10:12:24.345Z","end":"2026-10-22T10:12:24.345Z","id":"4ef30d6f-4caa-4cc7-83fa-871c0bea2132","parentId":"9008e6ab-c90d-4f5f-ab42-698752544b77"},{"name":"Execute Semantic Query","component":"DSE","start